{
    "name": "nvl/forms",
    "description": "Secure dynamic Laravel forms with localized content and submission workflows",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "forms",
        "validation",
        "spam-protection",
        "translation"
    ],
    "require": {
        "php": "^8.4",
        "ext-ctype": "*",
        "ext-filter": "*",
        "ext-mbstring": "*",
        "laravel/framework": "^12.0 || ^13.0",
        "nesbot/carbon": "^2.72 || ^3.0",
        "nvl/core": "^5.0",
        "nvl/filterable": "^5.0",
        "nvl/translatable": "^5.0",
        "ramsey/uuid": "^4.7",
        "spatie/laravel-data": "^4.23",
        "symfony/http-foundation": "^7.0 || ^8.0",
        "symfony/http-kernel": "^7.0 || ^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nvl/tenancy": "^5.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "spatie/typescript-transformer": "^3.3"
    },
    "suggest": {
        "nvl/activity": "Can consume the package's after-commit events in an application-owned audit integration",
        "nvl/tenancy": "Enables enforcing tenant ownership, scoped execution, adoption, and captured tenant queue contexts.",
        "spatie/typescript-transformer": "Consume the declared TypeScript attributes and metadata (^3.3); Core retains the runtime transformation engine."
    },
    "autoload": {
        "psr-4": {
            "Nvl\\Forms\\": "src/",
            "Nvl\\Forms\\Database\\Factories\\": "database/factories/",
            "Nvl\\Forms\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvl\\Forms\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G",
        "format": "pint --parallel --format agent",
        "format:test": "pint --parallel --test --format agent",
        "quality": [
            "@format:test",
            "@analyse",
            "@test"
        ],
        "test": "pest --compact"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "5.x-dev"
        },
        "laravel": {
            "providers": [
                "Nvl\\Forms\\Providers\\FormsServiceProvider"
            ],
            "aliases": []
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/database/factories/.gitkeep",
            "/database/seeders/.gitkeep",
            "/src/Http/Controllers/.gitkeep",
            "/src/Providers/.gitkeep",
            "/.temp",
            "/build",
            "/coverage",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/phpstan.neon.dist",
            "/phpunit.xml.dist",
            "/tests",
            "/.DS_Store",
            "/**/.DS_Store",
            "/.gitattributes",
            "/**/.gitattributes",
            "/.gitignore",
            "/**/.gitignore",
            "/**/.gitkeep"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "conflict": {
        "nvl/activity": "<5.0 || >=6.0",
        "nvl/tenancy": "<5.0 || >=6.0"
    },
    "homepage": "https://github.com/nvl-laravel-suite/forms",
    "authors": [
        {
            "name": "Nicolas Vlachos",
            "homepage": "https://github.com/nicolasvlachos",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/nvl-laravel-suite/forms",
        "docs": "https://github.com/nvl-laravel-suite/forms#readme",
        "issues": "https://github.com/nvl-laravel-suite/forms/issues",
        "security": "https://github.com/nvl-laravel-suite/forms/security/policy"
    }
}
